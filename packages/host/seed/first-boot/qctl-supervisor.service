# Managed by qctl — dual-socket supervisor (apps + admin)
[Unit]
Description=qctl supervisor (apps + admin sockets)
Documentation=https://github.com/qctl/qctl
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/qctl _internal_supervisor
Restart=on-failure
RestartSec=2
RuntimeDirectory=qctl
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
