[Unit]
Description=Rocky appliance first-boot (qctl _internal_init)
After=network-online.target local-fs.target
Wants=network-online.target
# Skip once the ready-stamp stage has succeeded
ConditionPathExists=!/var/lib/qctl/first-boot.done

[Service]
Type=oneshot
RemainAfterExit=yes
# Packages + stages can exceed the default 90s start timeout.
TimeoutStartSec=infinity
# Optional host-local overrides (identity comes from /etc/qctl/config.json via guest load-seed).
EnvironmentFile=-/etc/environment.d/90-qctl-platform.conf
# qctl _internal_init stops at the first failing stage, so the stamp is never written mid-failure.
# Mirror to serial — lab VMs often have no SSH until start-services (after admin keys).
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/local/bin/qctl _internal_init

[Install]
WantedBy=multi-user.target
