# Defaults for profiles with target: proxmox.
# Override api_url / node / vmid per profile in profile-<name>.yaml when needed.

proxmox:
  api_url: https://pve.example:8006
  # Replace with !env PROXMOX_API_TOKEN (add the key to .env.schema / .env.<env>)
  api_token: SET_PROXMOX_API_TOKEN
  node: pve
  cpu: 2
  memory: 4096

networking:
  interfaces:
    main:
      vm:
        mode: bridge
        bridge: vmbr0
        vlan: [2]
