[Unit]
Description=Rocky init-tank: create tank, export, poweroff (qctl _internal_init --profile init-tank)
DefaultDependencies=yes
After=network-online.target rocky-tier0-seal.service
Wants=network-online.target
ConditionPathExists=!/var/lib/rocky/init-tank-done

[Service]
Type=oneshot
RemainAfterExit=yes
# Seed-baked: QCTL_ENV (see 91-rocky-env.conf).
EnvironmentFile=-/etc/environment.d/91-rocky-env.conf
EnvironmentFile=-/etc/environment.d/90-qctl-platform.conf
Environment=ROCKY_TANK_CREATE_I_UNDERSTAND=yes
# Tier-0: LoadCredentialEncrypted via rocky-init-tank-prep.service.d/tier0.conf
# Mirror logs to serial — init-tank has no SSH; journal alone is useless on failure.
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/local/bin/qctl _internal_init --profile init-tank
# On failure stay up so host timeout + serial console can diagnose.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
