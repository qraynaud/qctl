{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["bun"],
    "removeComments": false,
    "paths": {
      "@qctl/shared": ["./packages/shared/src/index.ts"],
      "@qctl/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.js",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.d.ts",
    "ci/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "tooling"]
}
